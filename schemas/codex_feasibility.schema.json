{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Step 14 Codex feasibility packet",
  "description": "Bounded, sanitized local feasibility input persisted before the fresh Blueprint consultation.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "stage",
    "project_id",
    "brief_digest",
    "brief_revision",
    "context_digest",
    "discovery_digest",
    "project_url",
    "real_goal",
    "context",
    "discovery",
    "available_assets_digest",
    "asset_pack",
    "asset_pack_id",
    "asset_pack_digest",
    "candidate_zero_asset_id",
    "asset_layer_marker",
    "path",
    "marker",
    "resource_ids",
    "resource_digests",
    "resource_provenance",
    "route_instruction",
    "feasibility_digest"
  ],
  "properties": {
    "schema_version": { "const": "codex_feasibility.v1" },
    "stage": { "const": "CODEX_FEASIBILITY" },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "brief_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "brief_revision": { "type": "integer", "minimum": 1 },
    "context_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "discovery_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "project_url": { "type": "string", "pattern": "^https://chatgpt\\.com/g/g-p-[A-Za-z0-9][A-Za-z0-9._~-]*/project$" },
    "real_goal": { "type": "string", "minLength": 1, "maxLength": 12000 },
    "context": { "type": "object", "additionalProperties": true },
    "discovery": { "type": "object", "additionalProperties": true },
    "available_assets_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "asset_pack": { "type": "object", "additionalProperties": true },
    "asset_pack_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "asset_pack_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "candidate_zero_asset_id": { "type": ["string", "null"], "maxLength": 200 },
    "asset_layer_marker": { "const": "AVAILABLE_ASSET_LAYER_PASS" },
    "path": { "const": ".research/blueprint/CODEX_FEASIBILITY.json" },
    "marker": { "const": "CODEX_FEASIBILITY_PASS" },
    "resource_ids": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "resource_digests": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "resource_provenance": { "type": "object", "additionalProperties": true },
    "route_instruction": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "feasibility_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
