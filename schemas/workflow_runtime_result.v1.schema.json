{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow_runtime_result.v1.schema.json",
  "title": "Workflow runtime result v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "operation",
    "workspace_root",
    "project_id",
    "phase",
    "project_brief_path",
    "checkpoint_path",
    "brief_state",
    "brief_revision",
    "next_action",
    "next_tool",
    "question_id",
    "requirements",
    "original_requirement",
    "requirement_baseline",
    "question_count",
    "checkpoint"
  ],
  "properties": {
    "schema_version": {"const": "workflow_runtime_result.v1"},
    "operation": {"type": "string", "minLength": 1},
    "workspace_root": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "phase": {"enum": ["INTAKE", "WAITING_USER_APPROVAL", "READY", "AWAITING_DESIGN_REVIEW", "DESIGN_ACCEPTED", "PLANNED", "RUNNING", "COMPLETE", "BLOCKED"]},
    "project_brief_path": {"type": "string", "minLength": 1},
    "checkpoint_path": {"type": "string", "minLength": 1},
    "brief_state": {"type": "string", "minLength": 1},
    "brief_revision": {"type": "integer", "minimum": 0},
    "next_action": {"enum": ["ASK_REQUIREMENT", "REQUEST_BRIEF_APPROVAL", "REQUEST_DESIGN_REVIEW", "RUN_WORKFLOW", "CONTINUE_WORKFLOW", "COMPLETE", "BLOCKED"]},
    "next_tool": {"enum": ["workflow_answer", "workflow_run", null]},
    "requirements": {"type": "object"},
    "original_requirement": {"type": "string"},
    "requirement_baseline": {"type": "object"},
    "question": {"type": ["object", "null"]},
    "question_id": {"type": ["string", "null"]},
    "question_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "checkpoint": {"type": "object"},
    "design_review": {"type": "object"},
    "stage_created": {"type": "boolean"}
  }
}
