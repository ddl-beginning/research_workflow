{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Step 14 blueprint manifest",
  "description": "Machine-readable binding for PROJECT_BLUEPRINT.md and its approved evidence digests.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "project_id",
    "brief_digest",
    "context_digest",
    "discovery_digest",
    "feasibility_digest",
    "status",
    "next_action",
    "blueprint_path",
    "blueprint_digest",
    "primary_route",
    "alternatives",
    "composition_decision",
    "base_decision",
    "consultation",
    "stage_created",
    "stage_started",
    "production_architecture_selected",
    "marker",
    "manifest_path",
    "manifest_digest"
  ],
  "properties": {
    "schema_version": { "const": "blueprint_manifest.v1" },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "brief_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "context_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "discovery_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "feasibility_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "const": "PROJECT_BLUEPRINT_READY" },
    "next_action": { "const": "READY_FOR_STAGE_PLANNING" },
    "blueprint_path": { "const": ".research/blueprint/PROJECT_BLUEPRINT.md" },
    "blueprint_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "primary_route": { "type": "object", "minProperties": 1 },
    "alternatives": { "type": "array", "maxItems": 4, "items": { "type": ["string", "object"] } },
    "base_decision": {
      "enum": ["KEEP_EXISTING", "KEEP_AND_OPTIMIZE", "KEEP_AND_BORROW", "REPLACE_BASE", "BUILD_FROM_EXISTING_LIBRARIES", "BUILD_NEW"]
    },
    "composition_decision": {
      "enum": ["KEEP_EXISTING", "KEEP_AND_OPTIMIZE", "KEEP_AND_BORROW", "REPLACE_BASE", "BUILD_FROM_EXISTING_LIBRARIES", "BUILD_NEW"]
    },
    "existing_user_project_role": { "type": "string", "maxLength": 4000 },
    "external_repository_role": { "type": "string", "maxLength": 4000 },
    "available_assets_used": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 4000 } },
    "modules_to_keep": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 4000 } },
    "modules_to_borrow": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 4000 } },
    "modules_to_replace": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 4000 } },
    "modules_to_delete_retire": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 4000 } },
    "new_components_required": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 4000 } },
    "why_composition_preferred": { "type": "string", "maxLength": 12000 },
    "baseline_must_not_regress": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 4000 } },
    "anti_tunnel_architecture_risks": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 4000 } },
    "architecture_reset_triggers": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 4000 } },
    "available_assets_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "asset_pack_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "asset_layer_marker": { "const": "AVAILABLE_ASSET_LAYER_PASS" },
    "why_primary": { "type": "string", "maxLength": 12000 },
    "feasibility_summary": { "type": "string", "maxLength": 12000 },
    "validation_plan": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 4000 } },
    "important_risks": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 4000 } },
    "open_questions": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 4000 } },
    "consultation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "project_url", "request_count", "claims_digest", "feasibility_digest"],
      "properties": {
        "mode": { "const": "fresh" },
        "project_url": { "type": "string", "pattern": "^https://chatgpt\\.com/g/g-p-[A-Za-z0-9][A-Za-z0-9._~-]*/project$" },
        "request_count": { "const": 1 },
        "claims_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "feasibility_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "stage_created": { "const": false },
    "stage_started": { "const": false },
    "production_architecture_selected": { "const": false },
    "marker": { "const": "GPT_CODEX_BLUEPRINT_REVIEW_PASS" },
    "manifest_path": { "const": ".research/blueprint/BLUEPRINT_MANIFEST.json" },
    "manifest_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "persistent_inventory": { "type": "array", "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "idempotent_reuse": { "type": "boolean" },
    "consultation_count": { "const": 1 },
    "gpt_calls": { "const": 1 },
    "external_calls": { "const": 1 }
  }
}
