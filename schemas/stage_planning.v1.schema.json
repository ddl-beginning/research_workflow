{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage_planning.v1.schema.json",
  "title": "Step 15 Stage planning envelope",
  "description": "Alias of the canonical Step 15 Stage planning schema.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "project_id", "repository_root", "plan_id", "stage_id",
    "status", "planning_status", "stage_status", "next_action", "stage_created",
    "stage_started", "stage_contract_path", "stage_state_path", "input_paths",
    "input_digests", "baseline_digest", "contract_digest", "marker", "idempotent_reuse"
  ],
  "properties": {
    "schema_version": { "const": "stage_planning.v1" },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "repository_root": { "type": "string", "minLength": 1 },
    "plan_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "stage_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
    "status": { "const": "PLANNED" },
    "planning_status": { "const": "STAGE_PLANNING_COMPLETE" },
    "stage_status": { "const": "PLANNED" },
    "next_action": { "const": "USER_START_STAGE" },
    "stage_created": { "const": true },
    "stage_started": { "const": false },
    "stage_contract_path": { "type": "string", "minLength": 1 },
    "contract_path": { "type": "string", "minLength": 1 },
    "stage_state_path": { "const": ".research/stage-state.json" },
    "state_path": { "type": "string", "minLength": 1 },
    "stage_plan_path": {
      "type": "string",
      "pattern": "^\\.research/(stage-planning/STAGE_PLAN\\.json|stages/[A-Za-z0-9][A-Za-z0-9._-]{0,79}/STAGE_PLAN\\.json)$"
    },
    "input_paths": { "type": "array", "minItems": 3, "maxItems": 64, "items": { "type": "string", "minLength": 1 } },
    "input_digests": {
      "type": "object", "minProperties": 3,
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "baseline_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "contract_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "bootstrap_state_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "bootstrap_marker": { "type": ["string", "null"] },
    "planning_mode": { "type": "string", "enum": ["bootstrap_to_stage_contract", "accepted_design_to_stage_contract"] },
    "execution_handoff_path": { "const": ".research/execution-handoff/EXECUTION_HANDOFF.json" },
    "execution_handoff_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "design_package_path": { "const": ".research/DESIGN_PACKAGE.json" },
    "design_package_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "human_accept_receipt_path": { "const": ".research/design-review/HUMAN_ACCEPT_RECEIPT.json" },
    "human_accept_receipt_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "requirement_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "design_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "input_sizes": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "handoff_marker": { "const": "EXECUTION_HANDOFF_PASS" },
    "marker": { "const": "STAGE_PLANNING_PASS" },
    "idempotent_reuse": { "type": "boolean" },
    "stage": { "type": ["object", "null"] }
  }
}
