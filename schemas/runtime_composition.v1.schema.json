{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime_composition.v1.schema.json",
  "title": "Research workflow runtime composition v1",
  "description": "Portable, non-secret assembly settings for the existing Stage/Core/provider seams.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "lifecycle_version": {"type": "string", "enum": ["v1", "v2"]},
    "schema_version": {"type": "string", "const": "runtime_composition.v1"},
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state_path": {"type": "string", "minLength": 1},
        "contract_path": {"type": ["string", "null"], "minLength": 1},
        "stage_id": {"type": ["string", "null"], "minLength": 1},
        "receipt_root": {"type": "string", "minLength": 1}
      }
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "preferred_provider": {"type": ["string", "null"], "minLength": 1},
        "codex_executable": {"type": ["string", "null"], "minLength": 1},
        "preferred_model": {"type": "string", "minLength": 1},
        "fallback_model": {"type": ["string", "null"], "minLength": 1},
        "auth_mode": {"type": "string", "const": "chatgpt"},
        "timeout_seconds": {"type": "number", "minimum": 1, "maximum": 86400},
        "artifact_dir": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "bridge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_dir": {"type": ["string", "null"], "minLength": 1},
        "transport": {"type": ["string", "null"], "enum": ["homepage_fallback", null]},
        "enabled": {"type": "boolean"},
        "root": {"type": ["string", "null"], "minLength": 1},
        "node_executable": {"type": "string", "minLength": 1},
        "project_url": {"type": ["string", "null"], "minLength": 1},
        "entrypoint": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"], "minLength": 1},
        "source_digest": {"type": ["string", "null"], "minLength": 1},
        "dependency_lock_digest": {"type": ["string", "null"], "minLength": 1},
        "source_mode": {"type": "string", "enum": ["packaged", "external"]}
      }
    }
  }
}
