{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution_integration_stage_planning.v1.schema.json",
  "title": "Execution Integration Delivery Stage planning envelope",
  "description": "A separate plan for a delivery Stage registered after an approved source Stage.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "marker", "planning_status", "status", "stage_status",
    "next_action", "stage_created", "stage_started", "project_id",
    "repository_root", "plan_id", "stage_id", "stage_name", "stage_plan_path",
    "stage_contract_path", "stage_state_path", "source_stage_id",
    "source_stage_status", "source_stage_result_digest", "source_stage_state_revision",
    "integration_target", "verification_spec", "input_paths", "input_digests",
    "input_sizes", "baseline_digest", "contract_digest", "idempotent_reuse", "stage"
  ],
  "properties": {
    "schema_version": { "const": "execution_integration_stage_planning.v1" },
    "marker": { "const": "EXECUTION_INTEGRATION_STAGE_PLANNING_PASS" },
    "planning_status": { "const": "EXECUTION_INTEGRATION_STAGE_PLANNING_COMPLETE" },
    "status": { "const": "PLANNED" },
    "stage_status": { "const": "PLANNED" },
    "next_action": { "const": "USER_START_STAGE" },
    "stage_created": { "const": true },
    "stage_started": { "const": false },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "repository_root": { "type": "string", "minLength": 1 },
    "plan_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "stage_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
    "stage_name": { "type": "string", "minLength": 1, "maxLength": 512 },
    "stage_plan_path": { "type": "string", "minLength": 1 },
    "stage_contract_path": { "type": "string", "minLength": 1 },
    "stage_state_path": { "const": ".research/stage-state.json" },
    "source_stage_id": { "type": "string", "minLength": 1 },
    "source_stage_status": { "const": "APPROVED" },
    "source_stage_result_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_stage_state_revision": { "type": "integer", "minimum": 0 },
    "integration_target": { "type": "string", "minLength": 1 },
    "target_before_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "verification_spec": { "type": "object" },
    "input_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "input_digests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "input_sizes": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "baseline_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "contract_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "idempotent_reuse": { "type": "boolean" },
    "stage": { "type": "object" }
  }
}
