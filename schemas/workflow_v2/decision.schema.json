{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow V2 Subject-Bound Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "actor_kind", "boundary", "subject_id", "subject_digest", "subject_version", "allowed_choices", "requested_action", "provenance", "supersedes"],
  "properties": {
    "schema_version": {"const": "decision.v2"},
    "decision_id": {"type": "string", "minLength": 8},
    "actor_kind": {"type": "string", "enum": ["HUMAN", "GPT"]},
    "boundary": {"type": "string", "enum": ["REQUIREMENT", "DESIGN", "STAGE_PLANNING", "TECHNICAL_REVIEW"]},
    "subject_id": {"type": "string", "minLength": 1},
    "objective_identity": {"type": "string", "minLength": 8},
    "subject_type": {"type": "string", "minLength": 1},
    "subject_digest": {"type": "string", "minLength": 8},
    "subject_version": {"type": "integer", "minimum": 0},
    "allowed_choices": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "requested_action": {"type": "string", "minLength": 1},
    "provenance": {"type": "object"},
    "supersedes": {"type": ["string", "null"], "minLength": 8}
  }
}
