{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow V2 Operation Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "workspace_id", "subject_id", "intent_digest", "effect_state", "capability_manifest", "status"],
  "properties": {
    "schema_version": {"const": "operation_envelope.v2"},
    "operation_id": {"type": "string", "minLength": 8},
    "workspace_id": {"type": "string", "minLength": 8},
    "subject_id": {"type": "string", "minLength": 1},
    "intent_digest": {"type": "string", "minLength": 8},
    "effect_state": {"type": "string", "enum": ["INTENT_COMMITTED", "NOT_SENT_PROVEN", "SENT_UNSETTLED", "UNKNOWN", "RECEIPT_OBSERVED", "SETTLED", "CONFLICT"]},
    "capability_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_by_operation_id", "idempotent_submit", "fence", "prove_not_sent"],
      "properties": {
        "query_by_operation_id": {"type": "boolean"},
        "idempotent_submit": {"type": "boolean"},
        "fence": {"type": "boolean"},
        "prove_not_sent": {"type": "boolean"}
      }
    },
    "status": {"type": "string", "enum": ["INTENT", "RECEIPT_OBSERVED", "SETTLED", "BLOCKED"]}
  }
}
