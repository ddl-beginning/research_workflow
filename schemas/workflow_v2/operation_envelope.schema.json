{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow V2 Operation Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "workspace_id", "subject_id", "intent_digest", "effect_state", "capability_manifest", "status"],
  "properties": {
    "schema_version": {"const": "operation_envelope.v2"},
    "operation_id": {"type": "string", "minLength": 8},
    "workspace_id": {"type": "string", "minLength": 8},
    "subject_id": {"type": "string", "minLength": 1},
    "intent_digest": {"type": "string", "minLength": 8},
    "effect_state": {"type": "string", "enum": ["INTENT_COMMITTED", "NOT_SENT_PROVEN", "SENT_UNSETTLED", "UNKNOWN", "RECEIPT_OBSERVED", "SETTLED", "CONFLICT"]},
    "capability_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_by_operation_id", "idempotent_submit", "fence", "prove_not_sent"],
      "properties": {
        "query_by_operation_id": {"type": "boolean"},
        "idempotent_submit": {"type": "boolean"},
        "fence": {"type": "boolean"},
        "prove_not_sent": {"type": "boolean"}
      }
    },
    "handoff_invariant_version": {"const": "provider-handoff-v1"},
    "provider_handoff_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_operation_id", "stage_id", "iteration_id", "attempt_id",
        "provider_owner", "provider_route", "provider_request_identity",
        "request_digest", "reconstructible_request_descriptor", "idempotency_key",
        "reconciliation_identity", "dispatch_state"
      ],
      "properties": {
        "workflow_operation_id": {"type": "string", "minLength": 8},
        "project_id": {"type": "string", "minLength": 1},
        "stage_id": {"type": "string", "minLength": 1},
        "objective_identity": {"type": "string", "minLength": 8},
        "iteration_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 8},
        "provider_owner": {"type": "string", "minLength": 1},
        "provider_route": {"type": "string", "minLength": 1},
        "provider_request_identity": {"type": "string", "minLength": 8},
        "request_digest": {"type": "string", "minLength": 8},
        "reconstructible_request_descriptor": {"type": "object"},
        "idempotency_key": {"type": "string", "minLength": 8},
        "reconciliation_identity": {"type": "string", "minLength": 8},
        "dispatch_state": {"type": "string", "enum": ["PREPARED", "DISPATCHED", "RECEIPT_OBSERVED"]}
      }
    },
    "status": {"type": "string", "enum": ["INTENT", "RECEIPT_OBSERVED", "SETTLED", "BLOCKED"]},
    "receipt_digest": {"type": "string", "minLength": 8},
    "receipt": {"type": "object"}
  }
}
