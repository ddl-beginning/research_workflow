{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution_handoff.v1.schema.json",
  "title": "Approved Design execution handoff v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "marker", "status", "project_id", "repository_root",
    "requirement", "design", "human_decision", "research_provenance",
    "inputs", "input_digests", "stage", "stage_contract_path",
    "stage_plan_path", "handoff_digest"
  ],
  "properties": {
    "schema_version": {"const": "execution_handoff.v1"},
    "marker": {"const": "EXECUTION_HANDOFF_PASS"},
    "status": {"enum": ["READY_FOR_STAGE_PLANNING", "STAGE_PLANNED"]},
    "project_id": {"type": "string", "minLength": 1},
    "repository_root": {"type": "string", "minLength": 1},
    "requirement": {
      "type": "object",
      "required": ["path", "revision", "digest"],
      "properties": {
        "path": {"const": ".research/PROJECT_BRIEF.json"},
        "revision": {"type": "integer", "minimum": 0},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "design": {
      "type": "object",
      "required": ["path", "digest", "file_digest", "review_digest", "review_revision"],
      "properties": {
        "path": {"const": ".research/DESIGN_PACKAGE.json"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "file_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "review_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "review_revision": {"type": "integer", "minimum": 1}
      }
    },
    "human_decision": {
      "type": "object",
      "required": ["decision", "actor", "receipt_path", "receipt_digest"],
      "properties": {
        "decision": {"const": "ACCEPT"},
        "actor": {"type": "string", "minLength": 1},
        "receipt_path": {"const": ".research/design-review/HUMAN_ACCEPT_RECEIPT.json"},
        "receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "research_provenance": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {"type": "object", "required": ["path", "digest", "consultation_id", "conversation_id", "status", "request_count"]}
    },
    "inputs": {"type": "array", "minItems": 3, "maxItems": 64, "items": {"type": "string", "minLength": 1}},
    "input_digests": {
      "type": "object", "minProperties": 3,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "stage": {
      "type": "object",
      "required": ["stage_id", "stage_created", "stage_started"],
      "properties": {
        "stage_id": {"type": "string", "minLength": 1},
        "stage_created": {"type": "boolean"},
        "stage_started": {"type": "boolean"}
      }
    },
    "stage_contract_path": {"type": "string", "minLength": 1},
    "stage_plan_path": {"type": "string", "pattern": "^\\.research/(stage-planning/STAGE_PLAN\\.json|stages/[A-Za-z0-9][A-Za-z0-9._-]{0,79}/STAGE_PLAN\\.json)$"},
    "handoff_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
