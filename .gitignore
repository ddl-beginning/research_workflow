__pycache__/
*.py[cod]
.pytest_cache/
.research/
.consultations/
.tmp/
.workflow-v2/
*.egg-info/
# Defensive ignores for accidental local setup artifacts.  The canonical
# machine config and browser profile live outside this repository.
ResearchWorkflow/
browser-profile/
workspace-registry.json
health.json
cookies*.json
storage-state*.json
bridge/node_modules/
bridge/.auth/
bridge/.consultations/
bridge/.diagnostics/
bridge/playwright-report/
bridge/test-results/
bridge/*.auth.json
bridge/*.log

# Public repository must never capture machine credentials or browser state.
.auth/
**/.auth/
browser-profile/
**/browser-profile/
cookies*.json
**/cookies*.json
storage-state*.json
**/storage-state*.json
*.pem
*.p12
*.key
*.token
*.secret
.env
.env.*

# Local dependency/runtime caches.
node_modules/
**/node_modules/
*.log
playwright-report/
**/playwright-report/
test-results/
**/test-results/
